# Frontend (Next.js) — safe to expose in browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional: production URL for auth email redirects (e.g. https://your-app.vercel.app)
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Server only (API routes) — never expose to browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: override admin emails that approve signups (comma-separated).
# One variable is enough — used by API (server) and admin menu (client).
# If omitted, defaults in code apply (angelo + james@virtuology.com).
# NEXT_PUBLIC_ADMIN_EMAILS=andrianantenainaangelo55@gmail.com,james@virtuology.com
